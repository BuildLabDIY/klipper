# Tests for loadcell sensors
DICTIONARY atmega2560.dict
CONFIG load_cell.cfg

# Start by homing the printer.
G28
G1 F6000

# Z / X / Y moves
G1 Z1
G1 X1
G1 Y1

# Run bed_mesh_calibrate
BED_MESH_CALIBRATE

# Move again
G1 Z5 X0 Y0

# Do regular probe
PROBE

# Move again
G1 Z9

# Load cell commands
LOAD_CELL_TRACK_FORCE LOAD_CELL=my_hx711
LOAD_CELL_TRACK_FORCE LOAD_CELL=my_hx711 ENABLE=0
LOAD_CELL_READ LOAD_CELL=my_cs1237
